# ============================================================
# 七零喵僵尸末日生存 - SeverAdmin 服务器部署配置
# 复制为 .env 并按需修改
# 所有密码建议使用 20-48 位字母数字混合字符串
# 生成命令 (python): python3 -c "import secrets,string;print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(32)))"
# ============================================================

# ---------- 域名 / 站点 ----------
DOMAIN=mc.sh197.dpdns.org
SERVER_NAME=七零喵僵尸末日生存
SERVER_ADDRESS=mc.sh197.dpdns.org
SERVER_DESCRIPTION=1.20.1 Forge · 僵尸末日生存 · 动态难度 · 神话品质装备

# ---------- 端口 ----------
# MC 统一入口端口（玩家无需指定端口）
NGINX_MC_PORT=25565
# RCON 管理入口（外部监控工具连 mc.sh197.dpdns.org:25575）
# 由 nginx stream 转发到容器内 qlm-minecraft:25575
RCON_NGINX_PORT=25575
# HTTP/HTTPS 站点端口
HOST_HTTP_PORT=80
HOST_HTTPS_PORT=443

# ---------- 多重转发（多入口降低延迟，可选） ----------
# 除主入口外，可配置多个额外 MC 转发入口端口，分别指向不同后端/中转节点，
# 玩家可按地区选择最近入口，配合 tcp_nodelay/keepalive 调优降低延迟。
# 格式: MC_EXTRA_PORTS="端口:后端地址,端口:后端地址"
# 例:   MC_EXTRA_PORTS="25566:203.0.113.10:25565,25567:198.51.100.20:25565"
#       MC_EXTRA_PORTS="25566:qlm-minecraft:25565"   # 本机多入口分流
# 后端地址可为 qlm-minecraft:25565（本机）或外置中转节点 IP:端口。
# 留空则仅使用主入口。
MC_EXTRA_PORTS=
# 额外入口的宿主发布端口（容器内固定监听 25566/25567/25568，默认宿主同号）
MC_RELAY_PORT1=25566
MC_RELAY_PORT2=25567
MC_RELAY_PORT3=25568

# ---------- Minecraft 服务器 ----------
MC_MAX_PLAYERS=50
MC_VIEW_DISTANCE=10
MC_MAX_MEMORY=2G
ONLINE_MODE=false

# ---------- RCON（后台控制服务器必需） ----------
RCON_PASSWORD=CHANGE_ME_RCON_PASSWORD_32CHARS

# ---------- Web 后台认证 ----------
JWT_SECRET=CHANGE_ME_JWT_SECRET_32CHARS
ADMIN_USER=admin
ADMIN_PASS=CHANGE_ME_ADMIN_PASS_32CHARS
ADMIN_TOKEN=CHANGE_ME_ADMIN_TOKEN_32CHARS

# ---------- 下载中心（单个文件上限 500MB） ----------
MAX_UPLOAD_MB=500

# ---------- SSL（certbot，可选） ----------
SSL_EMAIL=admin@sh197.dpdns.org

# ---------- 部署模式：docker 或 java ----------
# docker: 使用 docker compose 编排（推荐）
# java:   使用 systemd 服务原生 Java 运行
DEPLOY_MODE=auto
